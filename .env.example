# Server
PORT=3000

# PostgreSQL (local o Supabase/Render)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=cotizador
# Supabase/Render requieren SSL -> true
PGSSL=false

# Límites de porcentajes en el cálculo de cotización
PORCENTAJE_FINANCIERO_MAX=100
PORCENTAJE_BONIFICACION_MAX=100

# BigQuery
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
BQ_PROJECT_ID=tu-proyecto
BQ_DATASET_ID=tu_dataset
BQ_BOM_TABLE=o_v_mesa_bom
# Modo PROVISORIO de datos: usa data/bomMuestras.json en vez de BigQuery.
# Poner en false (o borrar) cuando se conecte la tabla real.
BQ_MOCK=true
# Región del dataset (US o EU por defecto; ajustar si aplica)
BQ_LOCATION=US
# Antigüedad de la receta aceptada en días (0 = sin filtro)
BQ_BOM_MAX_DAYS=30
# TTL del caché en memoria de las recetas (horas)
BQ_CACHE_TTL_HORAS=24

# Columnas de la tabla/vista BOM (adaptar a tu esquema)
BQ_BOM_COL_PRODUCTO=producto
BQ_BOM_COL_NOMBRE_PRODUCTO=descripcion
BQ_BOM_COL_CODIGO_MP=codigo_mp
BQ_BOM_COL_NOMBRE_MP=nombre_mp
BQ_BOM_COL_CANTIDAD=cantidad
BQ_BOM_COL_FECHA=fecha